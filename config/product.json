  "default_queries": ["best {service} in {city}", "recommended {service} in {city}", "local {service} in {city}", "{service} services in {city}", "{business} reviews"],
  "recommendations": {
    "review_content": {"title": "Make the answer easy to find", "action": "Review the pages checked below. Add a clear heading for this question and a short, factual answer using your actual services and service area. Only publish details you have verified."},
    "schema": {"title": "Review your structured data", "action": "No JSON-LD was detected on the checked page. Review whether accurate LocalBusiness or relevant content markup belongs here. Markup is an optional improvement, not evidence of why an engine omitted you."},
    "retrieval": {"title": "Check access to this page", "action": "The page could not be fetched during this check. Review its response status, robots rules and access controls with your website provider."},
    "service_area": {"title": "State your service area clearly", "action": "The supplied location was not found in the pages checked. If you serve this area, add an accurate service-area statement where visitors can find it."}
  }
}
