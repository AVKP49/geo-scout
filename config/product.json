{
  "name": "GEO Scout",
  "min_queries": 3,
  "max_queries": 5,
  "cooldown_days": 30,
  "scan_rate_limit": "5 per hour;20 per day",
  "max_site_pages": 5,
  "scan_budget_usd": "0.30",
  "starter_price_usd": 49,
  "engines": {
    "google_aio": {"name": "Google AI Overviews", "source": "Google results via DataForSEO", "endpoint": "https://api.dataforseo.com/v3/serp/google/organic/live/advanced", "location": "United States", "language": "en"},
    "perplexity": {"name": "Perplexity API", "source": "Perplexity Agent API, fast effort; not the consumer app", "endpoint": "https://api.perplexity.ai/v1/agent", "effort": "fast", "max_output_tokens": 1200},
    "gemini": {"name": "Gemini API", "source": "Gemini API with Google Search grounding; not the consumer app", "endpoint": "https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent", "model": "gemini-2.5-flash", "max_output_tokens": 1800}
  },
  "demand_endpoint": "https://api.dataforseo.com/v3/keywords_data/google_ads/search_volume/live",
  "turnstile_endpoint": "https://challenges.cloudflare.com/turnstile/v0/siteverify",
  "postmark_endpoint": "https://api.postmarkapp.com/email",
  "categories": {
    "hvac": {"label": "HVAC", "service": "HVAC company", "queries": ["best HVAC company in {city}", "AC repair in {city}", "furnace replacement in {city}", "HVAC installation in {city}", "{business} reviews"]},
    "plumber": {"label": "Plumber", "service": "plumber", "queries": ["best plumber in {city}", "emergency plumbing in {city}", "water heater repair in {city}", "drain cleaning in {city}", "{business} reviews"]},
    "electrician": {"label": "Electrician", "service": "electrician"},
    "roofer": {"label": "Roofer", "service": "roofing company"},
    "contractor": {"label": "General contractor", "service": "general contractor"},
    "dentist": {"label": "Dentist", "service": "dentist"},
    "salon": {"label": "Salon", "service": "hair salon"},
    "restaurant": {"label": "Restaurant", "service": "restaurant"},
    "lawyer": {"label": "Lawyer", "service": "law firm"},
    "real_estate": {"label": "Real estate agent", "service": "real estate agent"},
    "food_blog": {"label": "Food blog", "service": "food blog", "queries": ["easy weeknight dinner recipes", "vegetarian dinner recipes", "one pot dinner recipes", "Indian dessert recipes", "{business} recipes"]},
    "local_guide": {"label": "Local guide", "service": "local guide"},
    "landscaper": {"label": "Landscaper", "service": "landscaper"},
