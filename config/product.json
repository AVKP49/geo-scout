    "pest_control": {"label": "Pest control", "service": "pest control company"},
    "garage_door": {"label": "Garage door service", "service": "garage door repair company"},
    "moving": {"label": "Moving company", "service": "moving company"},
    "pet_grooming": {"label": "Pet groomer", "service": "pet groomer"},
    "fitness": {"label": "Fitness studio", "service": "fitness studio"},
    "photography": {"label": "Photographer", "service": "photographer"},
    "childcare": {"label": "Childcare", "service": "childcare provider"},
    "accountant": {"label": "Accountant", "service": "accountant"},
